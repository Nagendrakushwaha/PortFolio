# ==============================================================================
# 1. OpenAI Realtime & Neural Speech Audio API (Recommended)
# ==============================================================================
# Provides natural conversational speech with human-like male voice (Echo / Ash / Onyx).
# Supports WebRTC full-duplex conversational audio or low-latency turn-based TTS.
#
# Cost Estimates:
# - OpenAI TTS-1: ~$0.015 per 1,000 characters (~$0.002 per spoken response)
# - OpenAI Realtime (gpt-4o-mini-realtime): ~$0.01/min audio input, $0.04/min audio output
#
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_VOICE="echo"                       # Options: echo (male default) | ash (male) | onyx (male) | fable (male) | alloy (neutral)
OPENAI_TTS_MODEL="tts-1"                  # Options: tts-1 | tts-1-hd
OPENAI_REALTIME_MODEL="gpt-4o-mini-realtime-preview" # Options: gpt-4o-mini-realtime-preview | gpt-4o-realtime-preview
OPENAI_CHAT_MODEL="gpt-4o-mini"

