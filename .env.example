# ==============================================================================
# Environment Configuration for Nagendra Kushwaha's AI Portfolio + Voice Assistant
# ==============================================================================
# Security Notice:
# All external AI API keys (OPENAI_API_KEY, ELEVENLABS_API_KEY) are STRICTLY kept
# on the backend and never bundled or exposed to client browsers.
#
# Zero-Credential Out-Of-The-Box Fallback:
# If no external API keys are configured, Mr. Kennedy automatically operates in
# zero-cost local mode utilizing the verified grounded knowledge engine and standard
# browser voice synthesis.
# ==============================================================================

# Core App Configuration
VITE_APP_TITLE="NAGENDRA KUSHWAHA | AI & DATA SCIENCE PORTFOLIO"
VITE_CONTACT_EMAIL="shibbuk707@gmail.com"
