# - Starter tier: $5/month for 30,000 characters
#
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb" # George (Warm, articulate British male)
# Alternative ElevenLabs Voice IDs:
