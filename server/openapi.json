{
  "openapi": "3.1.0",
  "info": {
    "title": "Nagendra Kushwaha AI/ML Portfolio API",
    "description": "Ground-truth API and tool interface for Nagendra Kushwaha's AI/ML Engineering & Data Science portfolio. Provides verified project architectures, 57 technical skills, academic credentials (B.Tech at Sam Global University, CGPA 7.85), professional experience (UptoSkill, BCG Forage), and AI assistant dialogue.",
    "version": "1.0.0",
    "contact": {
      "name": "Nagendra Kushwaha",
      "email": "shibbuk707@gmail.com",
      "url": "https://github.com/Nagendrakushwaha"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/mcp/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Get Nagendra Kushwaha's verified professional profile",
        "description": "Returns verified personal dossier including name, title, positioning, contact details, social links, academic details (Sam Global University, CGPA: 7.85/10), and downloadable resume links.",
        "responses": {
          "200": {
            "description": "Profile data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List all 12 verified AI/ML and Data Science projects",
        "description": "Returns a comprehensive list of verified projects with filters for domain (e.g., 'Artificial Intelligence', 'Machine Learning', 'Data Science', 'Computer Vision') or search keyword.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "description": "Filter by project domain (e.g. 'Artificial Intelligence', 'Machine Learning')",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search keyword matching project title, technologies, or description",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featured_only",
            "in": "query",
            "description": "Whether to return only featured projects (true/false)",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of projects retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/projects/{slug}": {
      "get": {
        "operationId": "getProjectDetails",
        "summary": "Get full technical case study and architecture for a specific project",
        "description": "Returns comprehensive architectural details, problem statement, objective, dataset specifications, verified performance metrics, GitHub repository URL, and live demo link for a given project slug.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "The unique identifier or slug of the project (e.g. 'customer-support-ai', 'sipervision-medical-imaging', 'speech-emotion-recognition', 'network-intrusion-detection', 'retail-sales-forecast')",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed project case study",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetail"
                }
              }
            }
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/mcp/skills": {
      "get": {
        "operationId": "getSkills",
        "summary": "Search and inspect 57 verified technical skills",
        "description": "Returns technical competencies categorized into Programming, Machine Learning, Deep Learning, NLP, Generative AI, Data, and Tools with proficiency levels.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter by skill category (e.g. 'Programming', 'Machine Learning', 'Deep Learning', 'NLP', 'Generative AI', 'Data', 'Tools')",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search keyword for specific libraries or frameworks (e.g. 'PyTorch', 'RAG', 'FastAPI')",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered technical skills",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "categories": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Skill"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/experience": {
      "get": {
        "operationId": "getExperience",
        "summary": "Get verified professional experience, internships, and mentorships",
        "description": "Returns verified work history: Data Analytics Intern at UptoSkill, Data Science Virtual Experience at BCG (Forage), Data Science Mentor at Internship Catalyst, and academic records.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by type ('internship', 'virtual_experience', 'mentorship', 'academic')",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of experience entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "experience": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExperienceItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/certifications": {
      "get": {
        "operationId": "getCertifications",
        "summary": "Get recognized industry certifications and specializations",
        "description": "Returns verified credentials including Deep Learning Specialization (Coursera / DeepLearning.AI), Machine Learning Specialization (Stanford Online), and Applied Data Science with Python (University of Michigan).",
        "responses": {
          "200": {
            "description": "List of certifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "certifications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CertificationItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp/chat": {
      "post": {
        "operationId": "chatWithKennedy",
        "summary": "Ask a question to Mr. Kennedy (Nagendra's AI Portfolio Companion)",
        "description": "Engage in grounded Q&A with Nagendra Kushwaha's AI representative, strictly answered using verified facts about Nagendra's background, projects, and skills.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "Question about Nagendra's experience, architecture choices, or skills"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer from Mr. Kennedy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": { "type": "string" },
                    "sources": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "direction": { "type": "string" },
          "positioning": { "type": "string" },
          "objective": { "type": "string" },
          "bioSummary": { "type": "string" },
          "education": {
            "type": "object",
            "properties": {
              "degree": { "type": "string" },
              "field": { "type": "string" },
              "institution": { "type": "string" },
              "period": { "type": "string" },
              "cgpa": { "type": "string" },
              "location": { "type": "string" }
            }
          },
          "contact": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "phone": { "type": "string" },
              "github": { "type": "string" },
              "linkedin": { "type": "string" },
              "location": { "type": "string" }
            }
          },
          "resumes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "url": { "type": "string" },
                "filename": { "type": "string" }
              }
            }
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "tag": { "type": "string" },
          "shortDescription": { "type": "string" },
          "technologies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "githubUrl": { "type": "string" },
          "liveDemoUrl": { "type": "string" },
          "featured": { "type": "boolean" }
        }
      },
      "ProjectDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "problemStatement": { "type": "string" },
          "objective": { "type": "string" },
          "technologies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "architectureOverview": { "type": "string" },
          "datasetInfo": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "samples": { "type": "string" },
              "sourceOrType": { "type": "string" }
            }
          },
          "methodology": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "status": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "challengesAndLimitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "githubUrl": { "type": "string" },
          "liveDemoUrl": { "type": "string" }
        }
      },
      "Skill": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ExperienceItem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "role": { "type": "string" },
          "organization": { "type": "string" },
          "period": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          },
          "skillsUsed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "isEmployment": { "type": "boolean" }
        }
      },
      "CertificationItem": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "issuer": { "type": "string" },
          "status": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}

